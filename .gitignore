# Wrangler local cache
.wrangler/

# Generated from wrangler.template.jsonc by `pnpm setup:config`. Holds ONE
# deployment's identity (Worker name, public URL, Cloudflare KV/D1 resource ids),
# which is per-deployment rather than per-repository — so it is generated rather
# than committed. Edit wrangler.template.jsonc, or your own .dev.vars.
wrangler.jsonc

