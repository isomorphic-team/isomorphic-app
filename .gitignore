node_modules

# Env
.dev.vars
.env
.env.*
!.env.example
!.dev.vars.example

# Wrangler local cache
.wrangler/

# Generated from wrangler.template.jsonc by `pnpm setup:config`. Holds ONE
# deployment's identity (Worker name, public URL, Cloudflare KV/D1 resource ids),
# which is per-deployment rather than per-repository — so it is generated rather
# than committed. Edit wrangler.template.jsonc, or your own .dev.vars.
wrangler.jsonc

# TypeScript incremental build info
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
app/.tailwind.out.css
.preview-build/
dev/bundle.js
# `pnpm web:dev` materializes dev/seed.ts here as a real git repo and then WRITES
# to it. Generated, disposable, and re-created by --reset.
dev/demo-brain*/

# Playwright run artifacts (traces, failure screenshots, the HTML report). The visual
# BASELINES under tests/ui/__screenshots__/ are committed on purpose — they are the
# expected output, not an artifact.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Local operational scripts with real infra/customer data (not for the public repo).
# Root-anchored so it does NOT match the tracked docs/ops/ directory.
/ops/
