{
	// ======================================================================
	// TEMPLATE for the objects Worker. `wrangler.objects.jsonc` is GENERATED from
	// this file by `pnpm setup:config`, alongside `wrangler.jsonc`, and is gitignored.
	//
	// The objects Worker implements the Durable Object classes the MCP Worker binds
	// by `script_name`. It is a separate Worker because a Worker that implements a
	// Durable Object gets no preview URLs, and the MCP Worker's deploy checks each
	// version on its preview URL before promoting it.
	//
	// Deploy it before the MCP Worker: `pnpm worker:deploy` does both, in order, and
	// so does .github/workflows/deploy.yml.
	// ======================================================================
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "__OBJECTS_WORKER_NAME__",
	"main": "src/objects/worker.ts",
	"compatibility_date": "2026-04-26",
	"observability": {
		"enabled": true
	},
	// Reached only through the MCP Worker's binding: no public URL.
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{ "name": "WRITE_COORDINATOR", "class_name": "WriteCoordinatorObject" },
			{ "name": "BRAIN_FILES", "class_name": "BrainFilesObject" }
		]
	},
	"vars": {
		// Backups of the brains this deployment holds (src/lib/brain-backup.ts). The
		// PUBLIC half of a key pair from `pnpm backup:keygen`, as base64: a backup is
		// sealed to it, and only the private half, which is never deployed, opens one.
		// Empty, or with no BACKUP_BUCKET, nothing is backed up.
		"BACKUP_PUBLIC_KEY": "__BACKUP_PUBLIC_KEY__",
		// A brain is backed up at most this often, and only after it changes.
		"BACKUP_INTERVAL_HOURS": "__BACKUP_INTERVAL_HOURS__"
	},
	// Append-only, by Cloudflare's rules: a class is added or deleted with a new tag,
	// and no entry is ever removed. A deploy that adds an entry cannot be rolled back
	// (docs/ops/deploy-and-rollback.md), so merge it on its own.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["WriteCoordinatorObject"] },
		{ "tag": "v2", "new_sqlite_classes": ["BrainFilesObject"] }
	],
	// The R2 bucket backups are written to. `pnpm setup:config` keeps this block only
	// when BACKUP_BUCKET is set; the bucket must exist before the deploy.
	// backups:start
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "__BACKUP_BUCKET__" }]
	// backups:end
}
