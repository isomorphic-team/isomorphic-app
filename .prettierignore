pnpm-lock.yaml

# Build output and local scratch. `pnpm format` writes and CI runs
# `prettier --check .`, so anything not committed has to be listed here or the
# two disagree depending on what happens to be on someone's disk. Prettier does
# not read .gitignore.
.wrangler/
.claude/
.preview-build/
dev/bundle.js
app/.tailwind.out.css
wrangler.jsonc

